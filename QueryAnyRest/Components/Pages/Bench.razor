@page "/"
@inject ConfigurationStore Store
@inject QueryChainService Chain
@inject TransformService Transformer
@inject JobRunner Runner
@inject NavigationManager Nav

<PageTitle>Bench — Query Any REST</PageTitle>

<div class="page-head">
    <div>
        <h1>Bench</h1>
        <p>Fire a saved chain, read each step's answer, and check what the final script would write before you let the schedule loose on it.</p>
    </div>
    <div class="actions">
        <a class="button" href="configurations">Configurations</a>
    </div>
</div>

@if (_configurations is null)
{
    <p class="subtle">Loading…</p>
}
else if (_configurations.Count == 0)
{
    <div class="panel">
        <div class="empty">
            <p>No configurations yet. Create one, or paste the settings block your API came with.</p>
            <a class="button primary" href="configurations">Go to configurations</a>
        </div>
    </div>
}
else
{
    <div class="panel">
        <div class="panel-body">
            <div class="grid">
                <div class="field">
                    <label for="picker">Configuration</label>
                    <select id="picker" value="@_selectedId" @onchange="OnSelectionChanged">
                        <option value="">Pick one…</option>
                        @foreach (var configuration in _configurations)
                        {
                            <option value="@configuration.Id">@configuration.Name</option>
                        }
                    </select>
                </div>

                @if (_selected is not null)
                {
                    <div class="field">
                        <label>Writes to</label>
                        <input type="text" class="mono" readonly
                               value="@System.IO.Path.Combine(_selected.Output.Directory, _selected.Output.BuildFileName(_selected.Transform.Format, DateTimeOffset.Now))" />
                    </div>
                }
            </div>

            @if (_selected is not null)
            {
                <div class="panel" style="margin-top:14px">
                    <div class="panel-head">
                        <div>
                            <h2>Steps</h2>
                            <p>Tweak the calls for this test. Changes here are not saved to the configuration.</p>
                        </div>
                        <div class="actions">
                            <button @onclick="ResetRequest" disabled="@_busy">Reset to saved</button>
                        </div>
                    </div>
                    <div class="panel-body">
                        @for (var i = 0; i < _selected.Steps.Count; i++)
                        {
                            var index = i;
                            var step = _selected.Steps[index];
                            <div class="panel" style="@(index == 0 ? "" : "margin-top:14px")" @key="step.Id">
                                <div class="panel-head"><h3>Step @(index + 1): @step.Name</h3></div>
                                <div class="panel-body">
                                    <RequestEditor Request="step.Request" IdPrefix="@($"bench-step{index}-")" Busy="_busy" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (_selected is not null)
            {
                <div class="actions" style="margin-top:14px">
                    <button class="primary" @onclick="() => RunAsync(false)" disabled="@_busy">
                        @(_busy ? "Working…" : "Send request")
                    </button>
                    <button @onclick="() => RunAsync(true)" disabled="@_busy">Send and write file</button>
                    <a class="button" href="@($"configurations/{_selected.Id}")">Edit configuration</a>
                    <span class="subtle">
                        @(_selected.Schedule.Enabled ? _selected.Schedule.Describe() : "No schedule")
                        · @DescribeAuth(_selected.Auth.Mode)
                    </span>
                </div>
            }
        </div>
    </div>
}

@if (_message is not null)
{
    <div class="notice @(_messageIsError ? "fail" : "ok")">@_message</div>
}

@if (_steps.Count > 0)
{
    <div class="panel">
        @if (_steps.Count > 1)
        {
            <div class="tabs" style="padding:10px 16px 0">
                @for (var i = 0; i < _steps.Count; i++)
                {
                    var index = i;
                    var outcome = _steps[index];
                    <button class="@(_selectedStepIndex == index ? "active" : "")" @onclick="() => _selectedStepIndex = index">
                        @outcome.StepName @(outcome.Response.Success ? "" : "⚠")
                    </button>
                }
            </div>
        }

        <div class="meta-strip">
            <div>
                <span>Status</span>
                <strong>@(CurrentStep.Response.StatusCode == 0 ? "—" : $"{CurrentStep.Response.StatusCode} {CurrentStep.Response.ReasonPhrase}")</strong>
            </div>
            <div><span>Time</span><strong>@CurrentStep.Response.ElapsedMs ms</strong></div>
            <div><span>Size</span><strong>@FormatBytes(CurrentStep.Response.Body.Length)</strong></div>
            <div><span>Type</span><strong>@(string.IsNullOrEmpty(CurrentStep.Response.ContentType) ? "—" : CurrentStep.Response.ContentType)</strong></div>
            @if (_transform is not null)
            {
                <div><span>Transform</span><strong>@(_transform.Success ? $"{FormatBytes(_transform.Content.Length)} in {_transform.ElapsedMs} ms" : "failed")</strong></div>
            }
            @if (_writtenPath is not null)
            {
                <div><span>Written</span><strong>@_writtenPath</strong></div>
            }
        </div>

        <div class="tabs">
            <button class="@(_tab == Tab.Transformed ? "active" : "")" @onclick="() => _tab = Tab.Transformed">
                What gets written
            </button>
            <button class="@(_tab == Tab.Request ? "active" : "")" @onclick="() => _tab = Tab.Request">
                Request
            </button>
            <button class="@(_tab == Tab.Body ? "active" : "")" @onclick="() => _tab = Tab.Body">
                Response body
            </button>
            <button class="@(_tab == Tab.Headers ? "active" : "")" @onclick="() => _tab = Tab.Headers">
                Headers
            </button>
            @if (_combinedLog.Count > 0)
            {
                <button class="@(_tab == Tab.Log ? "active" : "")" @onclick="() => _tab = Tab.Log">
                    Script log (@_combinedLog.Count)
                </button>
            }
        </div>

        @switch (_tab)
        {
            case Tab.Transformed:
                if (_transform is null)
                {
                    <div class="empty"><p>Nothing to transform yet.</p></div>
                }
                else if (!_transform.Success)
                {
                    <div class="panel-body">
                        <div class="notice fail">@_transform.Error</div>
                    </div>
                }
                else if (_transform.Content.Length == 0)
                {
                    <div class="empty"><p>The transform returned nothing, so no file would be written.</p></div>
                }
                else
                {
                    <pre class="payload">@Clip(_transform.Content)</pre>
                }
                break;

            case Tab.Request:
                <div class="panel-body">
                    <p class="mono">@CurrentStep.Response.RequestMethod @CurrentStep.Response.RequestUrl</p>
                </div>
                @if (CurrentStep.Response.RequestHeaders.Count > 0)
                {
                    <table>
                        <tbody>
                        @foreach (var header in CurrentStep.Response.RequestHeaders.OrderBy(h => h.Key))
                        {
                            <tr>
                                <td class="mono shrink">@header.Key</td>
                                <td class="mono">@header.Value</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                @if (!string.IsNullOrEmpty(CurrentStep.Response.RequestBody))
                {
                    <pre class="payload">@Clip(CurrentStep.Response.RequestBody)</pre>
                }
                break;

            case Tab.Body:
                <pre class="payload">@Clip(CurrentStep.Response.Body)</pre>
                break;

            case Tab.Headers:
                <table>
                    <tbody>
                    @foreach (var header in CurrentStep.Response.ResponseHeaders.OrderBy(h => h.Key))
                    {
                        <tr>
                            <td class="mono shrink">@header.Key</td>
                            <td class="mono">@header.Value</td>
                        </tr>
                    }
                    </tbody>
                </table>
                break;

            case Tab.Log:
                <pre class="payload">@string.Join('\n', _combinedLog)</pre>
                break;
        }
    </div>
}

@code {
    private enum Tab { Transformed, Request, Body, Headers, Log }

    [SupplyParameterFromQuery(Name = "configuration")]
    public string? ConfigurationFromQuery { get; set; }

    private List<ApiConfiguration>? _configurations;
    private ApiConfiguration? _selected;
    private string _selectedId = string.Empty;

    private List<StepOutcome> _steps = new();
    private int _selectedStepIndex;
    private TransformResult? _transform;
    private string? _writtenPath;
    private List<string> _combinedLog = new();

    private Tab _tab = Tab.Transformed;
    private bool _busy;
    private string? _message;
    private bool _messageIsError;

    private const int PreviewLimit = 200_000;

    private StepOutcome CurrentStep => _steps[Math.Clamp(_selectedStepIndex, 0, _steps.Count - 1)];

    protected override async Task OnInitializedAsync()
    {
        _configurations = (await Store.GetAllAsync()).ToList();

        var wanted = ConfigurationFromQuery;
        if (!string.IsNullOrEmpty(wanted) && _configurations.Any(c => c.Id == wanted))
        {
            await SelectAsync(wanted);
        }
        else if (_configurations.Count == 1)
        {
            await SelectAsync(_configurations[0].Id);
        }
    }

    private async Task OnSelectionChanged(ChangeEventArgs args) =>
        await SelectAsync(args.Value?.ToString() ?? string.Empty);

    private async Task SelectAsync(string id)
    {
        _selectedId = id;
        var stored = string.IsNullOrEmpty(id) ? null : await Store.GetAsync(id);
        _selected = stored?.Clone();

        _steps = new();
        _selectedStepIndex = 0;
        _transform = null;
        _writtenPath = null;
        _combinedLog = new();
        _message = null;
    }

    private async Task ResetRequest()
    {
        if (_selected is null) return;

        var stored = await Store.GetAsync(_selected.Id);
        if (stored is null) return;

        _selected.Steps = stored.Steps;
        _message = null;
    }

    private async Task RunAsync(bool writeFile)
    {
        if (_selected is null) return;

        _busy = true;
        _message = null;
        _writtenPath = null;

        try
        {
            if (writeFile)
            {
                // Goes through the same path as the scheduler, and calls every step exactly once.
                var outcome = await Runner.RunAsync(_selected, RunTrigger.Manual, writeFile: true, CancellationToken.None);

                _steps = outcome.Steps.ToList();
                _transform = outcome.Transform;
                _writtenPath = outcome.Record.FilePath;
                _combinedLog = outcome.Record.ScriptLog;

                if (!outcome.Record.Success)
                {
                    _message = outcome.Record.Error;
                    _messageIsError = true;
                }
                else if (outcome.Record.FilePath is null)
                {
                    _message = "The run succeeded but produced no content, so no file was written.";
                    _messageIsError = false;
                }
                else
                {
                    _message = $"Wrote {FormatBytes(outcome.Record.BytesWritten ?? 0)} to {outcome.Record.FilePath}.";
                    _messageIsError = false;
                }
            }
            else
            {
                // A dry run: no file, and nothing added to the history.
                var chain = await Chain.RunAsync(_selected, CancellationToken.None);
                _steps = chain.Steps.ToList();
                _transform = chain.Success ? Transformer.Apply(_selected, chain.Steps, chain.FinalContextJson) : null;
                _combinedLog = BuildDryRunLog(chain, _transform);

                if (!chain.Success)
                {
                    _message = chain.Error ?? "The request failed.";
                    _messageIsError = true;
                }
            }

            _selectedStepIndex = Math.Max(0, _steps.Count - 1);
            _tab = _steps.Count > 0 && _steps[^1].Response.Success ? Tab.Transformed : Tab.Request;
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageIsError = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private static List<string> BuildDryRunLog(ChainOutcome chain, TransformResult? transform)
    {
        var log = chain.Steps
            .SelectMany(step => step.BuildScriptLog.Select(line => $"[{step.StepName}] {line}"))
            .ToList();

        if (transform is not null) log.AddRange(transform.Log);
        return log;
    }

    private static string Clip(string content) =>
        content.Length <= PreviewLimit
            ? content
            : content[..PreviewLimit] + $"\n\n… {FormatBytes(content.Length - PreviewLimit)} more, not shown. The file on disk is complete.";

    private static string FormatBytes(long count) => count switch
    {
        < 1024 => $"{count} B",
        < 1024 * 1024 => $"{count / 1024.0:0.#} kB",
        _ => $"{count / (1024.0 * 1024.0):0.##} MB"
    };

    private static string DescribeAuth(AuthMode mode) => mode switch
    {
        AuthMode.OAuth2Password => "OAuth 2.0 password grant",
        AuthMode.StaticBearer => "Bearer token",
        _ => "No authentication"
    };
}
