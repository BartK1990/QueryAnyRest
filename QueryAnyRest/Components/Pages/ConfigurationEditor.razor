@page "/configurations/new"
@page "/configurations/{Id}"
@inject ConfigurationStore Store
@inject OAuthTokenService Tokens
@inject TokenStore TokenStates
@inject NavigationManager Nav

<PageTitle>@(_configuration?.Name ?? "Configuration") — Query Any REST</PageTitle>

@if (_configuration is null)
{
    <h1>Configuration</h1>
    <p class="subtle">@(_loadError ?? "Loading…")</p>
}
else
{
    <div class="page-head">
        <div>
            <h1>@(_isNew ? "New configuration" : _configuration.Name)</h1>
            <p>Set how the call is authenticated, what it asks for, how the answer is reshaped and when it repeats.</p>
        </div>
        <div class="actions">
            <a class="button" href="configurations">Back to list</a>
        </div>
    </div>

    @if (_problems.Count > 0)
    {
        <div class="notice fail">
            <strong>Fix these before saving</strong>
            <ul>
                @foreach (var problem in _problems)
                {
                    <li>@problem</li>
                }
            </ul>
        </div>
    }

    @if (_message is not null)
    {
        <div class="notice @(_messageIsError ? "fail" : "ok")">@_message</div>
    }

    <div class="panel">
        <div class="panel-head"><h2>Identity</h2></div>
        <div class="panel-body">
            <div class="grid">
                <div class="field">
                    <label for="name">Name</label>
                    <input id="name" type="text" @bind="_configuration.Name" />
                </div>
                <div class="field">
                    <label for="description">Description</label>
                    <input id="description" type="text" @bind="_configuration.Description"
                           placeholder="What this export is for" />
                </div>
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="panel-head">
            <div>
                <h2>Authentication</h2>
                <p>Open APIs need nothing here. The password grant caches its token and rotates the refresh token.</p>
            </div>
        </div>
        <div class="panel-body">
            <div class="grid">
                <div class="field">
                    <label for="authmode">Mode</label>
                    <select id="authmode" @bind="_configuration.Auth.Mode">
                        <option value="@AuthMode.None">No authentication</option>
                        <option value="@AuthMode.OAuth2Password">OAuth 2.0 password grant</option>
                        <option value="@AuthMode.StaticBearer">Bearer token I already have</option>
                    </select>
                </div>
            </div>

            @if (_configuration.Auth.Mode == AuthMode.StaticBearer)
            {
                <div class="grid" style="margin-top:14px">
                    <div class="field wide">
                        <label for="statictoken">Token</label>
                        <input id="statictoken" type="password" class="mono" autocomplete="new-password"
                               @bind="_newStaticToken" placeholder="@SecretPlaceholder(_configuration.Auth.StaticToken)" />
                        <span class="hint">Sent as <span class="mono">@_configuration.Auth.HeaderName: @_configuration.Auth.TokenPrefix &lt;token&gt;</span></span>
                    </div>
                </div>
            }

            @if (_configuration.Auth.Mode == AuthMode.OAuth2Password)
            {
                <div class="grid" style="margin-top:14px">
                    <div class="field wide">
                        <label for="authurl">Token URL</label>
                        <input id="authurl" type="text" class="mono" @bind="_configuration.Auth.AuthUrl"
                               placeholder="http://10.64.2.142/oneview4/auth" />
                    </div>
                    <div class="field">
                        <label for="username">User name</label>
                        <input id="username" type="text" @bind="_configuration.Auth.Username" />
                    </div>
                    <div class="field">
                        <label for="password">Password</label>
                        <input id="password" type="password" autocomplete="new-password"
                               @bind="_newPassword" placeholder="@SecretPlaceholder(_configuration.Auth.Password)" />
                        <span class="hint">@SecretHint(_configuration.Auth.Password)</span>
                    </div>
                    <div class="field">
                        <label for="clientid">Client id</label>
                        <input id="clientid" type="text" class="mono" @bind="_configuration.Auth.ClientId" />
                    </div>
                    <div class="field">
                        <label for="clientsecret">Client secret</label>
                        <input id="clientsecret" type="password" class="mono" autocomplete="new-password"
                               @bind="_newClientSecret" placeholder="@SecretPlaceholder(_configuration.Auth.ClientSecret)" />
                        <span class="hint">@SecretHint(_configuration.Auth.ClientSecret)</span>
                    </div>
                    <div class="field wide">
                        <label for="scope">Scope</label>
                        <input id="scope" type="text" class="mono" @bind="_configuration.Auth.Scope"
                               placeholder="public.webapi offline_access" />
                        <span class="hint">Most servers only issue a refresh token when <span class="mono">offline_access</span> is in the scope.</span>
                    </div>
                    <div class="field">
                        <label for="placement">Client credentials go in</label>
                        <select id="placement" @bind="_configuration.Auth.CredentialPlacement">
                            <option value="@ClientCredentialPlacement.RequestBody">The form body</option>
                            <option value="@ClientCredentialPlacement.BasicHeader">A Basic authorization header</option>
                        </select>
                    </div>
                    <div class="field">
                        <label for="skew">Refresh this many seconds early</label>
                        <input id="skew" type="number" min="0" max="3600" @bind="_configuration.Auth.RefreshSkewSeconds" />
                    </div>
                    <div class="field wide">
                        <label class="check">
                            <input type="checkbox" @bind="_configuration.Auth.UseRefreshToken" />
                            <span>
                                Refresh with the refresh token
                                <span class="hint">When off, every expiry sends the password again. When on, a rejected refresh still falls back to the password once.</span>
                            </span>
                        </label>
                    </div>
                    <div class="field wide">
                        <label>Extra token request fields</label>
                        <KeyValueEditor Items="_configuration.Auth.ExtraTokenParameters"
                                        KeyPlaceholder="acr_values" ValuePlaceholder="value"
                                        AddLabel="Add token field" />
                    </div>
                </div>

                <div class="panel" style="margin-top:16px">
                    <div class="panel-head">
                        <div>
                            <h2>Current token</h2>
                            <p>Held in <span class="mono">tokens.json</span> so a restart does not lose the rotation.</p>
                        </div>
                        <div class="actions">
                            <button @onclick="TestTokenAsync" disabled="@_busy">Get a token now</button>
                            <button @onclick="ForgetTokenAsync" disabled="@_busy">Forget token</button>
                        </div>
                    </div>
                    <div class="panel-body">
                        @if (_tokenState is null)
                        {
                            <p class="subtle">No token held. Save the configuration, then fetch one to check the credentials.</p>
                        }
                        else
                        {
                            <div class="grid thirds">
                                <div class="stack">
                                    <span class="subtle">Obtained by</span>
                                    <strong class="mono">@_tokenState.LastGrantUsed</strong>
                                </div>
                                <div class="stack">
                                    <span class="subtle">Expires</span>
                                    <strong class="mono">@_tokenState.ExpiresAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</strong>
                                </div>
                                <div class="stack">
                                    <span class="subtle">Refresh token</span>
                                    <strong class="mono">@(string.IsNullOrEmpty(_tokenState.RefreshToken) ? "none" : $"held, rotated {_tokenState.RefreshCount}×")</strong>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="panel">
        <div class="panel-head">
            <div>
                <h2>Steps</h2>
                <p>Each step makes its own call. A step after the first can use JavaScript to build its request from the steps that already ran.</p>
            </div>
            <div class="actions">
                <button @onclick="AddStep">Add step</button>
            </div>
        </div>
        <div class="panel-body">
            @for (var i = 0; i < _configuration.Steps.Count; i++)
            {
                var index = i;
                var step = _configuration.Steps[index];
                <div class="panel" style="@(index == 0 ? "" : "margin-top:14px")" @key="step.Id">
                    <div class="panel-head">
                        <div class="field" style="max-width:320px">
                            <label for="@($"stepname{index}")">Step @(index + 1) name</label>
                            <input id="@($"stepname{index}")" type="text" @bind="step.Name" />
                        </div>
                        <div class="actions">
                            <button @onclick="() => MoveStep(index, -1)" disabled="@(index == 0)">Move up</button>
                            <button @onclick="() => MoveStep(index, 1)" disabled="@(index == _configuration.Steps.Count - 1)">Move down</button>
                            <button class="danger" @onclick="() => RemoveStep(index)" disabled="@(_configuration.Steps.Count == 1)">Remove</button>
                        </div>
                    </div>
                    <div class="panel-body">
                        <RequestEditor Request="step.Request" IdPrefix="@($"step{index}-")" />

                        @if (index > 0)
                        {
                            <div class="field wide" style="margin-top:14px">
                                <label class="check">
                                    <input type="checkbox" @bind="step.UseBuildScript" />
                                    <span>
                                        Build this request from earlier results
                                        <span class="hint">Runs in a sandbox before the call goes out. No file, network or host access.</span>
                                    </span>
                                </label>
                            </div>
                        }

                        @if (index > 0 && step.UseBuildScript)
                        {
                            <div class="field wide">
                                <label for="@($"stepscript{index}")">Script</label>
                                <textarea id="@($"stepscript{index}")" class="mono" rows="10" @bind="step.BuildScript"></textarea>
                                <span class="hint">
                                    Available: <span class="mono">request</span> (this call &mdash; mutate it in place),
                                    <span class="mono">results</span> (every earlier step),
                                    <span class="mono">previous</span> (the last one, or null on step 1),
                                    <span class="mono">context</span> (shared with every step and the final script),
                                    <span class="mono">log(x)</span> (writes to the run log).
                                    Set <span class="mono">request.query.NAME</span> (or a header) to an array to repeat that name, e.g. <span class="mono">?NAME=a&amp;NAME=b</span>.
                                </span>
                            </div>
                            <div class="field">
                                <label for="@($"stepscripttimeout{index}")">Script timeout in seconds</label>
                                <input id="@($"stepscripttimeout{index}")" type="number" min="1" max="300" @bind="step.BuildScriptTimeoutSeconds" />
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="panel">
        <div class="panel-head">
            <div>
                <h2>Transform</h2>
                <p>Decides what lands in the file, built from every step in the chain. Without a script, the last step's response is re-indented as JSON or flattened to CSV.</p>
            </div>
        </div>
        <div class="panel-body">
            <div class="grid">
                <div class="field">
                    <label for="format">Output format</label>
                    <select id="format" @bind="_configuration.Transform.Format">
                        <option value="@OutputFormat.Json">JSON</option>
                        <option value="@OutputFormat.Csv">CSV</option>
                        <option value="@OutputFormat.Raw">Raw response</option>
                    </select>
                </div>
                <div class="field">
                    <label for="scripttimeout">Script timeout in seconds</label>
                    <input id="scripttimeout" type="number" min="1" max="300" @bind="_configuration.Transform.ScriptTimeoutSeconds" />
                </div>
                <div class="field wide">
                    <label class="check">
                        <input type="checkbox" @bind="_configuration.Transform.UseScript" />
                        <span>
                            Shape the response with JavaScript
                            <span class="hint">Runs in a sandbox with a time and memory limit. It has no file, network or host access.</span>
                        </span>
                    </label>
                </div>

                @if (_configuration.Transform.UseScript)
                {
                    <div class="field wide">
                        <label for="script">Script</label>
                        <textarea id="script" class="mono" rows="18" @bind="_configuration.Transform.Script"></textarea>
                        <span class="hint">
                            Available: <span class="mono">response</span> / <span class="mono">json</span> (the last step's raw text / parsed body),
                            <span class="mono">results</span> (every step), <span class="mono">context</span> (shared with every step),
                            <span class="mono">log(x)</span> (writes to the run log).
                            Return a string, or an object that gets stringified.
                        </span>
                    </div>
                    <div class="field wide">
                        <div class="actions">
                            <button @onclick="() => _configuration.Transform.Script = TransformSettings.DefaultCsvScript">Load the CSV example</button>
                            <button @onclick="() => _configuration.Transform.Script = TransformSettings.DefaultJsonScript">Load the JSON example</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="panel-head">
            <div>
                <h2>Output file</h2>
                <p>Where scheduled runs write. The service account needs write access to this folder.</p>
            </div>
        </div>
        <div class="panel-body">
            <div class="grid">
                <div class="field wide">
                    <label for="directory">Folder</label>
                    <input id="directory" type="text" class="mono" @bind="_configuration.Output.Directory"
                           placeholder="C:\ProgramData\QueryAnyRest\exports" />
                </div>
                <div class="field">
                    <label for="filename">File name</label>
                    <input id="filename" type="text" class="mono" @bind="_configuration.Output.FileNameBase" />
                </div>
                <div class="field">
                    <label for="stampformat">Timestamp format</label>
                    <input id="stampformat" type="text" class="mono" @bind="_configuration.Output.TimestampFormat" />
                </div>
                <div class="field">
                    <label for="extension">Extension override</label>
                    <input id="extension" type="text" class="mono" @bind="_configuration.Output.ExtensionOverride"
                           placeholder="from the format" />
                </div>
                <div class="field">
                    <label>Preview</label>
                    <input type="text" class="mono" readonly
                           value="@_configuration.Output.BuildFileName(_configuration.Transform.Format, DateTimeOffset.Now)" />
                </div>
                <div class="field wide">
                    <label class="check">
                        <input type="checkbox" @bind="_configuration.Output.AppendTimestamp" />
                        <span>Append the timestamp to the file name</span>
                    </label>
                </div>
                <div class="field wide">
                    <label class="check">
                        <input type="checkbox" @bind="_configuration.Output.UseLocalTimeInName" />
                        <span>
                            Use machine local time in the name
                            <span class="hint">Turn off to stamp in UTC, which avoids duplicate names at the autumn clock change.</span>
                        </span>
                    </label>
                </div>
                <div class="field wide">
                    <label class="check">
                        <input type="checkbox" @bind="_configuration.Output.SkipEmptyResults" />
                        <span>Skip the file when the transform produced nothing</span>
                    </label>
                </div>
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="panel-head">
            <div>
                <h2>Schedule</h2>
                <p>@(_configuration.Schedule.Enabled ? _configuration.Schedule.Describe() : "Runs only when you press Run.")</p>
            </div>
        </div>
        <div class="panel-body">
            <div class="grid">
                <div class="field wide">
                    <label class="check">
                        <input type="checkbox" @bind="_configuration.Schedule.Enabled" />
                        <span>Run this query on a schedule and write a file each time</span>
                    </label>
                </div>

                @if (_configuration.Schedule.Enabled)
                {
                    <div class="field">
                        <label for="mode">How often</label>
                        <select id="mode" @bind="_configuration.Schedule.Mode">
                            @* Without this the browser shows the first option while the model still says Manual. *@
                            <option value="@ScheduleMode.Manual" disabled>Pick how often…</option>
                            <option value="@ScheduleMode.EveryNMinutes">Every N minutes</option>
                            <option value="@ScheduleMode.Hourly">Every hour</option>
                            <option value="@ScheduleMode.Daily">Every day</option>
                            <option value="@ScheduleMode.Weekly">Every week</option>
                            <option value="@ScheduleMode.Monthly">Every month</option>
                        </select>
                    </div>

                    @switch (_configuration.Schedule.Mode)
                    {
                        case ScheduleMode.EveryNMinutes:
                            <div class="field">
                                <label for="interval">Minutes between runs</label>
                                <input id="interval" type="number" min="1" max="40320" @bind="_configuration.Schedule.IntervalMinutes" />
                            </div>
                            break;

                        case ScheduleMode.Hourly:
                            <div class="field">
                                <label for="minute">At minute</label>
                                <input id="minute" type="number" min="0" max="59" @bind="_configuration.Schedule.MinuteOfHour" />
                            </div>
                            break;

                        case ScheduleMode.Daily:
                            <div class="field">
                                <label for="dailytime">At</label>
                                <input id="dailytime" type="time" value="@_configuration.Schedule.TimeOfDay" @onchange="SetTimeOfDay" />
                            </div>
                            break;

                        case ScheduleMode.Weekly:
                            <div class="field">
                                <label for="weekday">On</label>
                                <select id="weekday" @bind="_configuration.Schedule.DayOfWeek">
                                    @foreach (var day in Enum.GetValues<DayOfWeek>())
                                    {
                                        <option value="@day">@day</option>
                                    }
                                </select>
                            </div>
                            <div class="field">
                                <label for="weeklytime">At</label>
                                <input id="weeklytime" type="time" value="@_configuration.Schedule.TimeOfDay" @onchange="SetTimeOfDay" />
                            </div>
                            break;

                        case ScheduleMode.Monthly:
                            <div class="field">
                                <label for="monthday">On day</label>
                                <input id="monthday" type="number" min="1" max="31" @bind="_configuration.Schedule.DayOfMonth" />
                                <span class="hint">Short months fall back to their last day.</span>
                            </div>
                            <div class="field">
                                <label for="monthlytime">At</label>
                                <input id="monthlytime" type="time" value="@_configuration.Schedule.TimeOfDay" @onchange="SetTimeOfDay" />
                            </div>
                            break;
                    }

                    <div class="field wide">
                        <label class="check">
                            <input type="checkbox" @bind="_configuration.Schedule.CatchUpMissedRuns" />
                            <span>
                                Catch up a run the machine was off for
                                <span class="hint">Off means a missed slot is skipped and the next one is waited for.</span>
                            </span>
                        </label>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="actions sticky">
        <button class="primary" @onclick="SaveAsync" disabled="@_busy">Save configuration</button>
        @if (!_isNew)
        {
            <a class="button" href="@($"/?configuration={_configuration.Id}")">Open on bench</a>
        }
        <span class="subtle">Times are machine local. The file is written by the service, not your browser.</span>
    </div>
}

@code {
    [Parameter] public string? Id { get; set; }

    // Secrets are never sent to the browser. These hold only what the user just typed;
    // an empty box means "keep whatever is already stored".
    private string _newPassword = string.Empty;
    private string _newClientSecret = string.Empty;
    private string _newStaticToken = string.Empty;

    private ApiConfiguration? _configuration;
    private TokenState? _tokenState;
    private bool _isNew;
    private bool _busy;
    private string? _loadError;
    private string? _message;
    private bool _messageIsError;
    private List<string> _problems = new();

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(Id))
        {
            _isNew = true;
            _configuration = new ApiConfiguration();
            _configuration.Steps.Add(new QueryStep { Name = "Step 1" });
            return;
        }

        _isNew = false;
        _configuration = await Store.GetAsync(Id);

        if (_configuration is null)
        {
            _loadError = "That configuration no longer exists.";
            return;
        }

        EnforceFirstStepHasNoBuildScript();
        _tokenState = await TokenStates.GetAsync(Id);

        _newPassword = string.Empty;
        _newClientSecret = string.Empty;
        _newStaticToken = string.Empty;
    }

    /// <summary>Copies any newly typed secret onto the configuration, leaving the rest untouched.</summary>
    private void ApplyTypedSecrets()
    {
        if (_configuration is null) return;

        if (!string.IsNullOrEmpty(_newPassword)) _configuration.Auth.Password = _newPassword;
        if (!string.IsNullOrEmpty(_newClientSecret)) _configuration.Auth.ClientSecret = _newClientSecret;
        if (!string.IsNullOrEmpty(_newStaticToken)) _configuration.Auth.StaticToken = _newStaticToken;

        _newPassword = string.Empty;
        _newClientSecret = string.Empty;
        _newStaticToken = string.Empty;
    }

    private void AddStep()
    {
        if (_configuration is null) return;
        _configuration.Steps.Add(new QueryStep { Name = $"Step {_configuration.Steps.Count + 1}" });
    }

    private void RemoveStep(int index)
    {
        if (_configuration is null || _configuration.Steps.Count <= 1) return;
        if (index < 0 || index >= _configuration.Steps.Count) return;
        _configuration.Steps.RemoveAt(index);
        EnforceFirstStepHasNoBuildScript();
    }

    private void MoveStep(int index, int delta)
    {
        if (_configuration is null) return;
        var target = index + delta;
        if (target < 0 || target >= _configuration.Steps.Count) return;
        (_configuration.Steps[index], _configuration.Steps[target]) = (_configuration.Steps[target], _configuration.Steps[index]);
        EnforceFirstStepHasNoBuildScript();
    }

    /// <summary>
    /// Whatever step ends up first has nothing before it to build from, so it never
    /// keeps a build script active — whether it arrived there by reordering or was
    /// loaded that way from a configuration saved before this rule existed.
    /// </summary>
    private void EnforceFirstStepHasNoBuildScript()
    {
        if (_configuration is null || _configuration.Steps.Count == 0) return;
        _configuration.Steps[0].UseBuildScript = false;
    }

    // A time input binds to TimeOnly in Razor, but the schedule stores HH:mm text.
    private void SetTimeOfDay(ChangeEventArgs e)
    {
        if (_configuration is null) return;
        if (TimeSpan.TryParse(e.Value?.ToString(), out var time))
            _configuration.Schedule.TimeOfDay = $"{time:hh\\:mm}";
    }

    private static string SecretPlaceholder(string stored) =>
        string.IsNullOrEmpty(stored) ? "Not set" : "Stored — leave blank to keep";

    private static string SecretHint(string stored) =>
        string.IsNullOrEmpty(stored)
            ? "Encrypted with the machine key ring when saved."
            : "A value is stored. Type here only to replace it.";

    private async Task SaveAsync()
    {
        if (_configuration is null) return;

        ApplyTypedSecrets();
        _problems = _configuration.Validate().ToList();
        if (_problems.Count > 0)
        {
            _message = null;
            return;
        }

        _busy = true;
        try
        {
            await Store.SaveAsync(_configuration);
            if (_isNew)
            {
                Nav.NavigateTo($"configurations/{_configuration.Id}");
                return;
            }

            Show("Saved.", isError: false);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task TestTokenAsync()
    {
        if (_configuration is null) return;

        ApplyTypedSecrets();
        _problems = _configuration.Validate().ToList();
        if (_problems.Count > 0) return;

        _busy = true;
        try
        {
            await Store.SaveAsync(_configuration);
            _tokenState = await Tokens.GetTokenAsync(_configuration, forceNew: true, CancellationToken.None);
            Show($"Token received, valid until {_tokenState.ExpiresAtUtc.ToLocalTime():HH:mm:ss}.", isError: false);
        }
        catch (TokenAcquisitionException ex)
        {
            Show(ex.Message, isError: true);
        }
        catch (Exception ex)
        {
            Show(ex.Message, isError: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ForgetTokenAsync()
    {
        if (_configuration is null) return;

        await Tokens.InvalidateAsync(_configuration.Id, CancellationToken.None);
        _tokenState = null;
        Show("Token discarded. The next run authenticates from scratch.", isError: false);
    }

    private void Show(string message, bool isError)
    {
        _message = message;
        _messageIsError = isError;
        _problems.Clear();
    }
}
